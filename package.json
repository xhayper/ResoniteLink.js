{
    "name": "resonitelink.js",
    "version": "0.0.0-alpha.4",
    "description": "A type-safe, easy to use JS wrapper for interacting with ResoniteLink",
    "keywords": [
        "resonite",
        "resonitelink",
        "api",
        "wrapper"
    ],
    "author": "xhayper",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xhayper/ResoniteLink.js.git"
    },
    "bugs": {
        "url": "https://github.com/xhayper/ResoniteLink.js/issues"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "del-cli dist",
        "build": "npm run clean && tsup src/index.ts --format esm,cjs --dts --clean",
        "prepack": "npm run build"
    },
    "dependencies": {
        "eventemitter3": "^5.0.4"
    },
    "optionalDependencies": {
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "del-cli": "^7.0.0",
        "tsup": "^8.5.1"
    }
}
